from typing import Optional

from .pupdevices import Motor


class DriveBase:
    def __init__(
        self,
        left_motor: Motor,
        right_motor: Motor,
        wheel_diameter: float,
        axle_track: float,
    ) -> None: ...
    def drive(self, speed: float, turn_rate: Optional[float] = None) -> None: ...
    def stop(self) -> None: ...
    def brake(self) -> None: ...
    def straight(self, distance: float, then: object = ...) -> None: ...
    def turn(self, angle: float, then: object = ...) -> None: ...
    def settings(
        self,
        straight_speed: Optional[float] = None,
        straight_acceleration: Optional[float] = None,
        turn_rate: Optional[float] = None,
        turn_acceleration: Optional[float] = None,
    ) -> None: ...
    def distance(self) -> float: ...
    def angle(self) -> float: ...
    def state(self) -> tuple: ...
    def reset(self) -> None: ...
    def use_gyro(self, use: bool) -> None: ...

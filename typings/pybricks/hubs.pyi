from typing import Optional

from .parameters import Button, Color


class _Display:
    def char(
        self, char: str, char_width: int = 50, char_height: int = 50
    ) -> None: ...
    def number(self, number: int) -> None: ...
    def text(self, text: str) -> None: ...
    def on(self, char: str) -> None: ...
    def off(self) -> None: ...
    def pixel(self, x: int, y: int, brightness: int = 100) -> None: ...


class _Light:
    def on(self, color: Color) -> None: ...
    def off(self) -> None: ...


class _Speaker:
    def beep(
        self, frequency: int = 500, duration: int = 100, volume: int = 100
    ) -> None: ...
    def play_notes(self, notes: object, tempo: int = 120) -> None: ...


class _Buttons:
    def pressed(self) -> set: ...


class _IMU:
    def heading(self) -> float: ...
    def reset_heading(self, angle: float = 0) -> None: ...
    def angle(self) -> float: ...
    def acceleration(self) -> tuple: ...
    def angular_velocity(self) -> tuple: ...
    def up(self) -> tuple: ...
    def tilt(self) -> tuple: ...


class _System:
    def storage(
        self, offset: int, read: int = 0, write: bytes = b""
    ) -> Optional[bytes]: ...
    def set_stop_button(self, button: Optional[Button]) -> None: ...
    def shutdown(self) -> None: ...


class _Battery:
    def voltage(self) -> int: ...
    def current(self) -> int: ...


class PrimeHub:
    def __init__(self, *args: object, **kwargs: object) -> None: ...
    display: _Display
    light: _Light
    speaker: _Speaker
    buttons: _Buttons
    imu: _IMU
    system: _System
    battery: _Battery

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Ejecutar en el hub (archivo abierto)",
      "detail": "Compila y sube el archivo que tienes abierto. USB si el hub está conectado; si no, Bluetooth.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/ejecutar.ps1",
        "-Ruta", "${file}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "▶ Ejecutar y ver mensajes (no soltar)",
      "detail": "Sube el archivo y se queda conectado para mostrar sus print(). Útil para 05 y main.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/ejecutar.ps1",
        "-Ruta", "${file}",
        "-Modo", "esperar"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "▶ Ejecutar y soltar el robot",
      "detail": "Sube el archivo, arranca el programa y se desconecta. El robot queda andando.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/ejecutar.ps1",
        "-Ruta", "${file}",
        "-Modo", "soltar"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "🔵 Ejecutar por Bluetooth",
      "detail": "Fuerza la conexión Bluetooth (aunque el cable USB esté puesto).",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/ejecutar.ps1",
        "-Ruta", "${file}",
        "-Conexion", "ble"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "✅ Revisar sintaxis (sin hub)",
      "detail": "Compila el archivo abierto con el compilador de Pybricks. No necesita el hub.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/ejecutar.ps1",
        "-Ruta", "${file}",
        "-SoloCompilar"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "🔌 Estado del hub y la conexión",
